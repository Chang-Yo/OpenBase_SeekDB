  {
    "name": "prompt-longtext-and-structure",
    "sql": "-- Data and expected predicates specified in CP1-TEST-PLAN.md.\nSELECT JSON_TYPE(JSON_EXTRACT(AI_PROMPT('{0}', JSON_ARRAY(1,TRUE)), '$.args[0]')) = 'ARRAY' AS json_array_preserved;\nSELECT JSON_EXTRACT(AI_PROMPT('{0}', JSON_OBJECT('k',2)), '$.args[0].k') = 2 AS json_object_preserved;\nSELECT JSON_TYPE(JSON_EXTRACT(AI_PROMPT('{0}', CAST('null' AS JSON)), '$.args[0]')) = 'NULL' AS json_null_preserved;\nSELECT JSON_UNQUOTE(JSON_EXTRACT(AI_PROMPT('{0}/{0}/{1}', 'a'), '$.template')) = '{0}/{0}/{1}' AS deferred_validation;\nDROP TABLE IF EXISTS regression_lob;\nCREATE TABLE regression_lob(c LONGTEXT, b BLOB);\nINSERT INTO regression_lob VALUES(REPEAT('长',100000),'ascii');\nSELECT LENGTH(JSON_UNQUOTE(JSON_EXTRACT(AI_PROMPT(c), '$.template'))) = 300000 AS full_template,\n       JSON_UNQUOTE(JSON_EXTRACT(AI_PROMPT('{0}',c),'$.args[0]')) = c AS full_argument,\n       JSON_UNQUOTE(JSON_EXTRACT(AI_PROMPT(b),'$.template')) = 'ascii' AS blob_template\nFROM regression_lob;\nDROP TABLE regression_lob;\n",
